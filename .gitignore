# Local Python/runtime environments
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Node / TypeScript (pnpm workspace: front + backend)
node_modules/
dist/
build/
*.tsbuildinfo
.npm/
.pnpm-store/
coverage/

# Next.js (front)
front/.next/
front/out/
.turbo/

# NestJS (backend) build output is covered by dist/ above

# Env / secrets
.env
.env.*
!.env.example

# macOS/local editor noise
.DS_Store

# ML model weights / checkpoints (never commit large weights)
*.pt
*.pth
*.onnx
*.pte
*.tflite
*.safetensors
*.ckpt
*.h5
models/
weights/
ml/weights
checkpoints/
ml/artifacts/pretrained/
# Trained PoC fall-detector artifacts (weights + metadata) — generated by
# running `python -m training.train`; never commit. RF's model.pkl is not
# caught by the *.pt rule, and committing metadata.json without weights would
# make the demo report a model "available" that then fails to load.
ml/artifacts/fall-detector

# ...but the training source package is code, not weights — keep it tracked.
# (Weight files inside it are still caught by the *.pt/*.pth rules above.)
!ml/training/models/
!ml/training/models/*.py

# Agent/tooling state
.omc/
.omo/
.omx/
.claude/scheduled_tasks.lock
.claude/worktrees/

# Skill eval run outputs (local benchmark artifacts, not source)
.claude/skills/*/evals/runloop-results/
.agents/skills/*/evals/runloop-results/

# Private/large video assets (kept local, NEVER pushed)
# Relocated assets/ -> ml/data/ (raw inputs + processed clips). Both stay local.
ml/data
assets/
# Throwaway experiment scratch (pose-probe weights + annotated frames derived
# from private footage). Local-only, NEVER pushed.
ml/.scratch/
.scratch/
# extra safety net: block raw media anywhere in the tree
*.mp4
*.mov
*.avi
*.mkv
