# .env.example — copy to .env and fill in real values.
# .env is gitignored; .env.example is tracked.
#
# Loaded automatically by semantic_scholar.py at import time (stdlib-only,
# no python-dotenv dependency). Real environment variables always win over
# values set here.

# ── Semantic Scholar API key ─────────────────────────────────────────────────
# Without a key: 1 request/second rate limit.
# With a key:    100ms between batches (~10x faster for large audits).
# Request a free key at: https://www.semanticscholar.org/product/api
S2_API_KEY=

# ── Gate thresholds (all optional — defaults shown) ─────────────────────────
# Minimum citation count for papers published 1–3 years ago.
#SRC_GATE_CIT_1_3Y=3

# Minimum citation count for papers published 4–5 years ago.
#SRC_GATE_CIT_4_5Y=5

# Minimum citation count for papers published 6+ years ago.
#SRC_GATE_CIT_6Y=5

# Minimum citation count for arXiv-only preprints (no DOI, no venue).
#SRC_GATE_CIT_ARXIV_ONLY=50

# Top-N rank cutoff in GS Metrics category for venue-only pass (0–1y papers).
#SRC_GATE_VENUE_TOP_N=10

# ── Monorepo runtime SSOT (ports + URLs) ─────────────────────────────────────
# Single source of truth for the standard service port map. Native dev
# (`pnpm dev:*` / `uv run`) reads these via each service's own env file; the
# Docker Compose lane interpolates the same ${VAR} values once app services land.
#
#   front (Next.js)      → 3000   (next dev default; no --port flag)
#   backend (NestJS)     → 8080
#   ml-serving (FastAPI) → 8000
#   db (Postgres)        → 5432
FRONT_PORT=3000
BACKEND_PORT=8080
ML_SERVING_PORT=8000
POSTGRES_PORT=5432

# Browser-facing API URL. NEXT_PUBLIC_* is bundled into the browser, so it must
# always point at a host the user's browser can reach (localhost) — never a
# Docker service name. Server-side/internal calls will use Compose service names
# (e.g. http://backend:8080), injected by Compose once the app services are added.
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── Auth secrets (compose interpolates these into the backend service) ───────
# KAKAO_TOKEN_ENC_KEY encrypts per-user Kakao access tokens at rest (AES-256-GCM).
# Must decode (hex or base64) to exactly 32 bytes. Override the compose dev default
# with a real random key (e.g. `openssl rand -hex 32`) in any shared/prod env.
# KAKAO_TOKEN_ENC_KEY=
