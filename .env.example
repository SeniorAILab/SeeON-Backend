# Environment contracts are split by host runtime at the repository root.
#
# Local development:
#   cp .env.local.example .env.local
#
# Production host:
#   cp .env.host.prod.example .env.host.prod
#   docker compose --env-file .env.host.prod --profile full -f compose.yaml -f compose.prod.yaml up -d
#
# ML runtime environment is separated → SeniorAILab/eldercare-fall-ml.
