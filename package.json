{
  "name": "eldercare-fall-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Fall-detection platform host services.",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:front": "pnpm --filter front dev",
    "dev:backend": "node scripts/dev/dev-local.mjs backend",
    "dev:backend:fresh": "node scripts/dev/dev-local.mjs backend --reset",
    "dev:backend:app": "pnpm --filter backend start:dev",
    "build:front": "pnpm --filter front build",
    "build:backend": "pnpm --filter backend build",
    "typecheck": "pnpm --filter front exec tsc -b && pnpm --filter backend exec tsc --noEmit",
    "lint": "pnpm -r lint",
    "format": "pnpm --filter backend format",
    "env:verify": "node scripts/env/verify-compose-env-contract.mjs",
    "env:local:verify": "node scripts/dev/ensure-local-env.mjs",
    "backend:db:up": "docker compose --env-file .env.local up -d db",
    "backend:db:down": "docker compose down",
    "backend:db:reset": "node scripts/db/reset-local.mjs",
    "backend:prisma:generate": "pnpm --filter backend run prisma:generate",
    "backend:prisma:migrate": "pnpm --filter backend run prisma:migrate",
    "backend:prisma:seed": "pnpm --filter backend run prisma:seed",
    "compose:local:up": "docker compose --env-file .env.local --profile full up -d --build",
    "compose:prod:up": "docker compose --env-file .env.host.prod --profile full -f compose.yaml -f compose.prod.yaml up -d",
    "compose:down": "docker compose down",
    "release:prod": "node scripts/release/create-production-release.mjs",
    "smoke:backend:no-db": "pnpm --filter backend run smoke:no-db",
    "backend:demo:bind": "SEED_BIND_DEMO_USERS=true pnpm --filter backend run prisma:seed"
  }
}
