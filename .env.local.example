# Local development environment template.
#
# Copy this file to .env.local:
#   cp .env.local.example .env.local
#
# .env.local is gitignored and is the only supported local runtime env file for
# native backend, Vite frontend, Prisma scripts, and local Docker Compose.

# ── Semantic Scholar / NotebookLM source curation ───────────────────────────
S2_API_KEY=
#SRC_GATE_CIT_1_3Y=3
#SRC_GATE_CIT_4_5Y=5
#SRC_GATE_CIT_6Y=5
#SRC_GATE_CIT_ARXIV_ONLY=50
#SRC_GATE_VENUE_TOP_N=10

# ── Monorepo local ports ────────────────────────────────────────────────────
FRONT_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5432

# ── Backend native runtime ──────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
FRONT_ORIGIN=http://localhost:3000
DATABASE_URL="postgresql://fall_app:fall_app@localhost:5432/fall_dev?schema=public"
DIRECT_URL="postgresql://fall:fall@localhost:5432/fall_dev?schema=public"

# ── Frontend native runtime ─────────────────────────────────────────────────
VITE_USE_MOCK=false
VITE_API_BASE_URL=/api/v1

# ── Local auth / demo secrets ───────────────────────────────────────────────
SESSION_JWT_SECRET=dev-only-session-secret-change-me-32chars-min
JWT_TTL=12h
# Auth JWT cookie is httpOnly, SameSite=Strict, and Secure when FRONT_ORIGIN is https
# or NODE_ENV=production. For local HTTP development leave AUTH_COOKIE_SECURE unset
# or set AUTH_COOKIE_SECURE=false.
# AUTH_COOKIE_SECURE=false
# Demo seed login for the Nokyang facility admin (`nokyang-admin@example.com`).
# Local reset uses this explicit template value; production must set a real secret.
NOKYANG_ADMIN_PASSWORD=1234
# Local super-admin bootstrap: set SUPER_ADMIN_PASSWORD then run
#   pnpm --filter backend exec ts-node prisma/seed-super-admin.ts
# (email defaults to admin@example.com). Empty password skips the bootstrap.
# SUPER_ADMIN_EMAIL=admin@example.com
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NICKNAME=Senior AI Lab
# SUPER_ADMIN_FACILITY_ID=
# Outbound alert email (SMTP). Template sentinel only — replace with a real
# Gmail app password (never a real secret value) in .env.local before using
# email delivery locally.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-alerts@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM='Eldercare Safety <your-alerts@gmail.com>'
SMTP_SECURE=false
ALERT_DASHBOARD_URL=http://localhost:3000
