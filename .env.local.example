# Local development environment template.
#
# Copy this file to .env.local:
#   cp .env.local.example .env.local
#
# .env.local is gitignored and is the only supported local runtime env file for
# native backend, Vite frontend, Prisma scripts, and local Docker Compose.

# ── Semantic Scholar / NotebookLM source curation ───────────────────────────
S2_API_KEY=
#SRC_GATE_CIT_1_3Y=3
#SRC_GATE_CIT_4_5Y=5
#SRC_GATE_CIT_6Y=5
#SRC_GATE_CIT_ARXIV_ONLY=50
#SRC_GATE_VENUE_TOP_N=10

# ── Monorepo local ports ────────────────────────────────────────────────────
FRONT_PORT=3000
BACKEND_PORT=8080
ML_SERVING_PORT=8000
POSTGRES_PORT=5432

# ── Backend native runtime ──────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
FRONT_ORIGIN=http://localhost:3000
DATABASE_URL="postgresql://fall_app:fall_app@localhost:5432/fall_dev?schema=public"
DIRECT_URL="postgresql://fall:fall@localhost:5432/fall_dev?schema=public"
ML_SERVING_URL="http://localhost:8000"

# ── Frontend native runtime ─────────────────────────────────────────────────
VITE_USE_MOCK=false
VITE_API_BASE_URL=/api/v1

# ── Local auth / demo secrets ───────────────────────────────────────────────
SESSION_JWT_SECRET=dev-only-session-secret-change-me-32chars-min
JWT_TTL=12h
# Auth JWT cookie is httpOnly, SameSite=Strict, and Secure when FRONT_ORIGIN is https
# or NODE_ENV=production. For local HTTP development leave AUTH_COOKIE_SECURE unset
# or set AUTH_COOKIE_SECURE=false.
# AUTH_COOKIE_SECURE=false
# Demo seed login for the Nokyang facility admin (`nokyang-admin@example.com`).
# Local reset uses this explicit template value; production must set a real secret.
NOKYANG_ADMIN_PASSWORD=1234
# Optional Kakao user binding during prisma:seed. Requires SEED_BIND_DEMO_USERS=true.
# SEED_BIND_DEMO_USERS=false
# SEED_BIND_KAKAO_ID=
# SEED_BIND_KAKAO_EMAIL=rhqjatn310@kakao
# Local super-admin bootstrap: set SUPER_ADMIN_PASSWORD then run
#   pnpm --filter backend exec ts-node prisma/seed-super-admin.ts
# (email defaults to admin@example.com). Empty password skips the bootstrap.
# SUPER_ADMIN_EMAIL=admin@example.com
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NICKNAME=Senior AI Lab
# SUPER_ADMIN_FACILITY_ID=
# Template sentinel only. Replace in .env.local before using Kakao OAuth.
KAKAO_REST_API_KEY=dev-placeholder-kakao-rest-api-key
# KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/api/v1/auth/kakao/callback
KAKAO_TOKEN_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# KAKAO_TOKEN_PATH=./var/kakao-token.json
# KAKAO_SCOPES=talk_message
ALERT_DASHBOARD_URL=http://localhost:3000
# KAKAO_MESSAGE_LINK_URL=
# KAKAO_MESSAGE_ENDPOINT=https://kapi.kakao.com/v2/api/talk/memo/default/send

# ── Edge simulation from local machine ──────────────────────────────────────
# API_BACKEND_EVENTS_URL=http://localhost:8080/api/v1/events
# API_EDGE_RELAY_TOKEN=local-edge-relay-token
# Bearer token ml-api sends to the backend Event API (issue #552). Uncomment and
# set the same value on both sides to exercise the guard locally; the backend
# also accepts API_EDGE_RELAY_TOKEN above as a fallback if this is unset.
# EDGE_FACILITY_TOKEN=local-edge-relay-token
# VITE_ML_API_RELAY_TOKEN=local-edge-relay-token
# API_CAMERA_INVENTORY facility_id: demo facility id is an auto-generated cuid resolvable with SELECT id FROM facilities WHERE code='happy-nokyang'.
# DEMO_RESIDENT_ID=
# DEMO_FACILITY_ID=
