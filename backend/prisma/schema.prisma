// Prisma schema — Postgres everywhere.
// provider is locked; dev/prod differ only by DATABASE_URL / DIRECT_URL.
//
// DATABASE_URL  = fall_app role (NOSUPERUSER NOBYPASSRLS) — runtime.
// DIRECT_URL    = fall superuser — migrations + schema introspection only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum AlertStatus {
  NEW
  ACKED
  RESOLVED
}

enum DashboardReceiptKind {
  DELIVERY
  PRESENTATION
}

enum SpaceType {
  ROOM
  HALLWAY
  PROGRAM_ROOM
  REHAB_ROOM
  DINING
  LOBBY
  OFFICE
  NURSE_STATION
  ENTRANCE
  STORAGE
  STAFF_LOUNGE
  ETC
}

enum MediaClipStatus {
  PENDING
  READY
  UNAVAILABLE
  EXPIRED
  DELETED
}

enum MediaStorageState {
  NONE
  STAGED
  READY
  DELETING
  DELETED
}

enum MediaClipReason {
  CAPTURE_FAILED
  QUEUE_FULL
  CORRUPT
  LEGACY_MISSING
  UPLOAD_TIMEOUT
  STORAGE_MISSING
  RETENTION_EXPIRED
  ADMIN_DELETED
  LEGAL_ERASURE
}

enum MediaHoldKind {
  LEGAL
  ACCESS_REQUEST
  INCIDENT
}

enum MediaAccessAction {
  METADATA_READ
  CONTENT_GRANTED
  CONTENT_COMPLETED
  CONTENT_ABORTED
  PLAY_STARTED
  FULLSCREEN_ENTERED
}

enum MediaAccessOutcome {
  ALLOWED
  DENIED
  NOT_FOUND
  NOT_READY
  FAILED
}

// ─── Root/auth tables (not tenant-domain list/query surfaces) ────────────────

/// Root tenant. Not RLS-protected (gated by app-layer membership check).
model Facility {
  id                         String   @id @default(cuid())
  name                       String
  businessRegistrationNumber String?  @map("business_registration_number")
  address                    String?  @map("address")
  phone                      String?  @map("phone")
  createdAt                  DateTime @default(now()) @map("created_at")

  users User[]

  cameras           Camera[]
  alerts            Alert[]
  alertNotes        AlertNote[]
  dashboardReceipts DashboardReceipt[]

  floors Floor[]
  spaces Space[]

  events Event[]

  mediaClips MediaClip[]
  mlConfig   MlFacilityConfig?

  @@map("facilities")
}

/// Facility-level ML runtime config SSOT (Plane-P). One row per facility.
/// Not RLS-protected (facility-scoped via explicit facilityId, like Facility); holds
/// no PHI/credentials. configVersion is a monotonic opaque token bumped in the same
/// transaction as any camera or night-window mutation (frozen contract PR-B0 c/d).
model MlFacilityConfig {
  facilityId    String   @id @map("facility_id")
  configVersion Int      @default(0) @map("config_version")
  nightStart    String   @default("21:00") @map("night_start")
  nightEnd      String   @default("07:00") @map("night_end")
  tz            String   @default("Asia/Seoul")
  updatedAt     DateTime @updatedAt @map("updated_at")

  facility Facility @relation(fields: [facilityId], references: [id])

  @@map("ml_facility_config")
}

/// Platform identity root. facilityId is nullable until onboarding completes; auth code
/// must access users by authenticated user/session only, then bind facilityId before
/// tenant-domain data queries. No tenant data list/detail route may query User.
model User {
  id         String  @id @default(cuid())
  /// Null until onboarding binds the user to a facility (see model doc).
  facilityId String? @map("facility_id")
  email      String? @unique

  passwordHash       String?  @map("password_hash")
  phone              String?  @map("phone")
  notificationEmail  String?  @map("notification_email")
  emailAlertsEnabled Boolean  @default(true) @map("email_alerts_enabled")
  nickname           String
  role               Role     @default(STAFF)
  /// Increment to invalidate all existing sessions for this user.
  sessionVersion     Int      @default(0) @map("session_version")
  createdAt          DateTime @default(now()) @map("created_at")

  facility Facility? @relation(fields: [facilityId], references: [id])

  deliveryAttempts DeliveryAttempt[]
  ackedAlerts      Alert[]           @relation("AlertAckedBy")
  resolvedAlerts   Alert[]           @relation("AlertResolvedBy")
  alertNotes       AlertNote[]       @relation("AlertNoteCreatedBy")

  @@map("users")
}

// ─── Tenant tables (facilityId-scoped, RLS ENABLE + FORCE) ────────────────────────

/// Camera. Composite unique (facilityId, id) supports composite FK
/// references from Alert and Event rows.
model Camera {
  id         String    @id @default(cuid())
  facilityId String    @map("facility_id")
  spaceId    String    @map("space_id")
  label      String
  rtspUrl    String?   @map("rtsp_url")
  lastSeenAt DateTime? @map("last_seen_at")
  online     Boolean   @default(false)
  createdAt  DateTime  @default(now()) @map("created_at")

  facility Facility @relation(fields: [facilityId], references: [id])
  space    Space    @relation(fields: [facilityId, spaceId], references: [facilityId, id])
  alerts   Alert[]

  events     Event[]
  mediaClips MediaClip[]

  @@unique([facilityId, id])
  @@unique([facilityId, label])
  @@unique([facilityId, spaceId])
  @@map("cameras")
}

/// Alert event log. alertSeq (BIGSERIAL) is the SSE Last-Event-ID ordering key.
/// Composite unique (facilityId, idempotencyKey) prevents exact-duplicate ingestion.
model Alert {
  id         String @id @default(cuid())
  /// Monotonically increasing within the table; used as SSE Last-Event-ID.
  alertSeq   BigInt @default(autoincrement()) @map("alert_seq")
  facilityId String @map("facility_id")

  /// Nullable: alert may originate from an unconfigured camera path.
  cameraId       String?     @map("camera_id")
  spaceId        String      @map("space_id")
  type           String
  probability    Float
  /// Internal facility-scoped storage key for the snapshot image (never a raw URL).
  snapshotKey    String?     @map("snapshot_key")
  detectedAt     DateTime    @map("detected_at")
  status         AlertStatus @default(NEW)
  /// Server-derived: hash(cameraId + detectedAt + type). Sender-supplied keys ignored.
  idempotencyKey String      @map("idempotency_key")
  /// Required: every alert originates from a persisted event (Event API ingress).
  originEventId  String      @map("origin_event_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  /// Null until acked; SetNull when the acking user is deleted (audit actor).
  ackedById      String?     @map("acked_by_id")
  ackedAt        DateTime?   @map("acked_at")
  /// Null until resolved; SetNull when the resolving user is deleted (audit actor).
  resolvedById   String?     @map("resolved_by_id")
  resolvedAt     DateTime?   @map("resolved_at")

  facility Facility @relation(fields: [facilityId], references: [id])

  /// Composite FK (facilityId, cameraId) → Camera(facilityId, id) prevents
  /// an alert from referencing a camera in a different facility (F9).
  camera            Camera?            @relation(fields: [facilityId, cameraId], references: [facilityId, id])
  space             Space              @relation(fields: [facilityId, spaceId], references: [facilityId, id])
  originEvent       Event              @relation("AlertOriginEvent", fields: [facilityId, originEventId], references: [facilityId, id])
  /// Lifecycle audit actors. Simple nullable FK → users(id); same-facility is an
  /// app-layer guarantee (session actor + RequireFacilityGuard + facility-scoped write).
  ackedBy           User?              @relation("AlertAckedBy", fields: [ackedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  resolvedBy        User?              @relation("AlertResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  notes             AlertNote[]
  dashboardReceipts DashboardReceipt[]

  @@unique([facilityId, id])
  @@unique([facilityId, idempotencyKey])
  @@index([facilityId, alertSeq])
  @@index([facilityId, spaceId, alertSeq])
  @@index([facilityId, status, alertSeq])
  @@index([ackedById])
  @@index([resolvedById])
  @@map("alerts")
}

model AlertNote {
  id          String   @id @default(cuid())
  facilityId  String   @map("facility_id")
  alertId     String   @map("alert_id")
  note        String
  /// SetNull when the authoring user is deleted; authorRole keeps the audit trail readable.
  createdById String?  @map("created_by_id")
  authorRole  Role     @map("author_role")
  createdAt   DateTime @default(now()) @map("created_at")

  facility  Facility @relation(fields: [facilityId], references: [id])
  alert     Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdBy User?    @relation("AlertNoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([facilityId, alertId, createdAt])
  @@index([alertId])
  @@index([createdById])
  @@map("alert_notes")
}

/// Immutable ML event SSOT. RLS-protected and append-only for the app role.
model Event {
  id                 String   @id @default(cuid())
  facilityId         String   @map("facility_id")
  cameraId           String   @map("camera_id")
  spaceId            String   @map("space_id")
  type               String
  confidence         Float?
  detectedAt         DateTime @map("detected_at")
  createdAt          DateTime @default(now()) @map("created_at")
  modifiedAt         DateTime @updatedAt @map("modified_at")
  dedupKey           String   @map("dedup_key")
  configVersion      Int?     @map("config_version")
  modelVersion       String?  @map("model_version")
  detectorVersion    String?  @map("detector_version")
  operatingThreshold Float?   @map("operating_threshold")
  snapshotKey        String?  @map("snapshot_key")
  clockSource        String?  @map("clock_source")
  /// Edge-reported clip reference (not an FK); the authoritative binding is EventMediaBinding.
  clipId             String?  @map("clip_id")
  /// Edge-generated event UUID for ingest dedup; null when the edge did not supply one.
  edgeEventId        String?  @map("edge_event_id") @db.Uuid

  facility          Facility           @relation(fields: [facilityId], references: [id])
  camera            Camera             @relation(fields: [facilityId, cameraId], references: [facilityId, id])
  space             Space              @relation(fields: [facilityId, spaceId], references: [facilityId, id])
  originAlerts      Alert[]            @relation("AlertOriginEvent")
  dashboardReceipts DashboardReceipt[]

  mediaBinding EventMediaBinding?

  @@unique([facilityId, id])
  @@unique([facilityId, dedupKey])
  @@unique([facilityId, edgeEventId])
  @@index([facilityId, detectedAt, id])
  @@index([facilityId, cameraId, detectedAt])
  @@map("events")
}

model DashboardReceipt {
  id                String               @id @default(cuid())
  facilityId        String               @map("facility_id")
  dashboardClientId String               @map("dashboard_client_id") @db.VarChar(128)
  kind              DashboardReceiptKind
  backendEventId    String               @map("backend_event_id")
  alertId           String               @map("alert_id")
  alertSeq          BigInt               @map("alert_seq")
  surface           String               @db.VarChar(64)
  observedAt        DateTime             @map("observed_at")
  createdAt         DateTime             @default(now()) @map("created_at")

  facility     Facility @relation(fields: [facilityId], references: [id])
  backendEvent Event    @relation(fields: [facilityId, backendEventId], references: [facilityId, id])
  alert        Alert    @relation(fields: [facilityId, alertId], references: [facilityId, id])

  @@unique([facilityId, dashboardClientId, kind, alertId, alertSeq, surface], name: "dashboard_receipt_history_client_kind_alert_seq_surface_key", map: "dashboard_receipt_history_client_kind_alert_seq_surface_key")
  @@index([facilityId, backendEventId, createdAt], map: "dashboard_receipt_history_facility_event_created_idx")
  @@index([facilityId, alertId, createdAt], map: "dashboard_receipt_history_facility_alert_created_idx")
  @@map("dashboard_receipt_history")
}

/// Backend-owned clip aggregate. Lifecycle tombstones remain in this row.
model MediaClip {
  id             String            @id @default(cuid())
  facilityId     String            @map("facility_id")
  cameraId       String            @map("camera_id")
  externalClipId String            @map("external_clip_id") @db.VarChar(200)
  status         MediaClipStatus   @default(PENDING)
  stateVersion   Int               @default(1) @map("state_version")
  reason         MediaClipReason?
  storageState   MediaStorageState @default(NONE) @map("storage_state")
  stagingToken   String?           @map("staging_token") @db.Char(64)
  storageKey     String?           @unique @map("storage_key")
  contentType    String?           @map("content_type")
  byteSize       BigInt?           @map("byte_size")
  sha256         String?           @db.Char(64)
  codec          String?           @db.VarChar(32)
  durationMs     Int?              @map("duration_ms")
  finalizedAt    DateTime?         @map("finalized_at")
  clipStartAt    DateTime?         @map("clip_start_at")
  clipEndAt      DateTime?         @map("clip_end_at")
  stagedAt       DateTime?         @map("staged_at")
  readyAt        DateTime?         @map("ready_at")
  expiresAt      DateTime?         @map("expires_at")
  expiredAt      DateTime?         @map("expired_at")
  deletedAt      DateTime?         @map("deleted_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  facility Facility             @relation(fields: [facilityId], references: [id])
  camera   Camera               @relation(fields: [facilityId, cameraId], references: [facilityId, id])
  events   EventMediaBinding[]
  holds    MediaRetentionHold[]

  @@unique([facilityId, id])
  @@unique([facilityId, externalClipId])
  @@index([facilityId, status, expiresAt])
  @@index([facilityId, storageState, stagedAt])
  @@map("media_clips")
}

/// One immutable event binds to at most one clip; a clip may bind many events.
model EventMediaBinding {
  eventId    String   @id @map("event_id")
  facilityId String   @map("facility_id")
  clipId     String   @map("clip_id")
  ordinal    Int      @map("ordinal")
  createdAt  DateTime @default(now()) @map("created_at")

  event Event     @relation(fields: [facilityId, eventId], references: [facilityId, id])
  clip  MediaClip @relation(fields: [facilityId, clipId], references: [facilityId, id])

  @@unique([facilityId, eventId])
  @@unique([facilityId, clipId, ordinal])
  @@index([facilityId, clipId])
  @@map("event_media_bindings")
}

model MediaRetentionHold {
  id               String        @id @default(cuid())
  facilityId       String        @map("facility_id")
  clipId           String        @map("clip_id")
  kind             MediaHoldKind
  reason           String        @db.VarChar(500)
  /// Creating actor user id (no FK — audit value survives user deletion); null for system-created holds.
  createdByUserId  String?       @map("created_by_user_id")
  /// Releasing actor user id (no FK); null while the hold is active or when released by automation.
  releasedByUserId String?       @map("released_by_user_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  releasedAt       DateTime?     @map("released_at")

  clip MediaClip @relation(fields: [facilityId, clipId], references: [facilityId, id])

  @@index([facilityId, clipId, releasedAt])
  @@map("media_retention_holds")
}

/// Append-only audit snapshots intentionally avoid cascading relations.
model MediaAccessLog {
  id              BigInt             @id @default(autoincrement())
  facilityId      String             @map("facility_id")
  actorUserId     String             @map("actor_user_id")
  actorRole       Role               @map("actor_role")
  /// Snapshot reference (no FK, append-only audit); null when access targeted no specific clip.
  clipId          String?            @map("clip_id")
  /// Snapshot reference (no FK); null when the access was not alert-scoped.
  alertId         String?            @map("alert_id")
  targetAlertHash String             @map("target_alert_hash") @db.Char(64)
  action          MediaAccessAction
  outcome         MediaAccessOutcome
  httpStatus      Int                @map("http_status")
  requestId       String             @map("request_id") @db.VarChar(64)
  /// Client idempotency token (unique per actor); null when the client sent none.
  interactionId   String?            @map("interaction_id") @db.VarChar(64)
  rangeStart      BigInt?            @map("range_start")
  rangeEnd        BigInt?            @map("range_end")
  bytesPlanned    BigInt?            @map("bytes_planned")
  bytesActual     BigInt?            @map("bytes_actual")
  ipHash          String?            @map("ip_hash") @db.Char(64)
  userAgent       String?            @map("user_agent") @db.VarChar(512)
  occurredAt      DateTime           @default(now()) @map("occurred_at")

  @@unique([actorUserId, interactionId])
  @@index([facilityId, occurredAt])
  @@index([facilityId, clipId, occurredAt])
  @@index([requestId])
  @@map("media_access_logs")
}

/// Facility floor. RLS-protected. Composite unique (facilityId, id) supports
/// composite child FKs from spaces.
model Floor {
  id         String   @id @default(cuid())
  facilityId String   @map("facility_id")
  name       String
  orderIndex Int      @map("order_index")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  facility Facility @relation(fields: [facilityId], references: [id])
  spaces   Space[]

  @@unique([facilityId, name])
  @@unique([facilityId, id])
  @@map("floors")
}

/// Facility space/room.
model Space {
  id            String    @id @default(cuid())
  facilityId    String    @map("facility_id")
  floorId       String    @map("floor_id")
  name          String
  type          SpaceType
  capacity      Int
  isActive      Boolean   @default(true) @map("is_active")
  assignedStaff String?   @map("assigned_staff")
  createdAt     DateTime  @default(now()) @map("created_at")

  facility Facility @relation(fields: [facilityId], references: [id])
  floor    Floor    @relation(fields: [facilityId, floorId], references: [facilityId, id])
  camera   Camera?
  alerts   Alert[]

  events Event[]

  @@unique([facilityId, floorId, name])
  @@unique([facilityId, id])
  @@map("spaces")
}

// ─── Backend-owned alert outbox (issue #29) ─────────────────────────────────
// AlertEvent/DeliveryAttempt are NOT tenant-domain RLS tables. They are keyed
// by source_id (ingest source) + external_event_id for idempotency, owned by the
// backend alert pipeline, and intentionally excluded from PrismaService's
// TENANT_MODELS guard (no facility context required). See the backend section of
// the ADR.

enum AlertEventType {
  FALL
  DETECTION_LOST
  BED_EXIT
}

enum AlertDecision {
  DISPATCH
  SUPPRESS
}

enum AlertSuppressedReason {
  COOLDOWN
  HOURLY_CAP
  BELOW_THRESHOLD
}

enum DeliveryChannel {
  EMAIL
}

enum DeliveryAttemptStatus {
  PENDING
  SENT
  RETRY_SCHEDULED
  TERMINAL_FAILED
}

enum DeliveryFailureClass {
  TRANSIENT
  TERMINAL_OPERATOR_ACTION
}

/// Backend alert outbox row. (source_id, external_event_id) is the idempotency
/// key; P2002 on that unique constraint signals a duplicate ingress.
model AlertEvent {
  id                 String                 @id @default(cuid())
  sourceId           String                 @map("source_id")
  externalEventId    String                 @map("external_event_id")
  type               AlertEventType
  detectedAt         DateTime               @map("detected_at")
  confidence         Float?
  fallProbability    Float?                 @map("fall_probability")
  operatingThreshold Float?                 @map("operating_threshold")
  decision           AlertDecision
  suppressedReason   AlertSuppressedReason? @map("suppressed_reason")
  deliveryAttempts   DeliveryAttempt[]
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  @@unique([sourceId, externalEventId], name: "alert_events_source_external_event_id_key")
  @@index([detectedAt], name: "alert_events_detected_at_idx")
  @@map("alert_events")
}

/// Per-channel delivery attempt with retry/terminal classification.
model DeliveryAttempt {
  id                String                @id @default(cuid())
  alertEventId      String                @map("alert_event_id")
  alertEvent        AlertEvent            @relation(fields: [alertEventId], references: [id], onDelete: Cascade)
  /// SetNull when the recipient user is deleted; the delivery record is kept for audit.
  recipientUserId   String?               @map("recipient_user_id")
  recipientUser     User?                 @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)
  channel           DeliveryChannel
  status            DeliveryAttemptStatus @default(PENDING)
  attemptCount      Int                   @default(0) @map("attempt_count")
  nextAttemptAt     DateTime?             @map("next_attempt_at")
  providerReference String?               @map("provider_reference")
  failureClass      DeliveryFailureClass? @map("failure_class")
  terminalReason    String?               @map("terminal_reason")
  operatorAction    String?               @map("operator_action")
  lastError         String?               @map("last_error")
  sentAt            DateTime?             @map("sent_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@unique([alertEventId, recipientUserId], name: "delivery_attempts_alert_event_id_recipient_user_id_key")
  @@index([status, nextAttemptAt], name: "delivery_attempts_status_next_attempt_at_idx")
  @@index([alertEventId], name: "delivery_attempts_alert_event_id_idx")
  @@index([recipientUserId], name: "delivery_attempts_recipient_user_id_idx")
  @@map("delivery_attempts")
}
