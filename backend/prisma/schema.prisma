// Prisma schema — Postgres everywhere (ADR-002, ADR-C).
// provider is locked; dev/prod differ only by DATABASE_URL / DIRECT_URL.
//
// DATABASE_URL  = fall_app role (NOSUPERUSER NOBYPASSRLS) — runtime (ADR-A).
// DIRECT_URL    = fall superuser — migrations + schema introspection only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  CAREGIVER
}

enum AlertStatus {
  NEW
  ACKED
  RESOLVED
}

enum ResidentState {
  NORMAL
  WARNING
  FALL
}

enum SpaceType {
  ROOM
  HALLWAY
  PROGRAM_ROOM
  REHAB_ROOM
  DINING
  LOBBY
  OFFICE
  NURSE_STATION
  ENTRANCE
  STORAGE
  STAFF_LOUNGE
  ETC
}

enum ZoneType {
  BED
  AREA
}

enum Level {
  LOW
  MEDIUM
  HIGH
}

// ─── Root/auth tables (not tenant-domain list/query surfaces) ────────────────

/// Root tenant. Not RLS-protected (gated by app-layer membership check).
model Facility {
  id                         String   @id @default(cuid())
  name                       String
  businessRegistrationNumber String?  @map("business_registration_number")
  code                       String   @unique @map("code")
  address                    String?  @map("address")
  phone                      String?  @map("phone")
  createdAt                  DateTime @default(now()) @map("created_at")

  users            User[]
  residents        Resident[]
  cameras          Camera[]
  alerts           Alert[]
  guardians        Guardian[]
  residentStatuses ResidentStatus[]
  floors           Floor[]
  spaces           Space[]
  zones            Zone[]
  assignments      ResidentAssignment[]
  kakaoIdentities  KakaoIdentity[]
  sessions         ServerSession[]
  @@map("facilities")
}

/// Platform identity root. facilityId is nullable until onboarding completes; auth code
/// must access users by authenticated user/session only, then bind facilityId before
/// tenant-domain data queries. No tenant data list/detail route may query User.
model User {
  id             String   @id @default(cuid())
  facilityId          String?  @map("facility_id")
  kakaoId        String   @unique @map("kakao_id")
  email          String?
  nickname       String
  role           Role     @default(ADMIN)
  /// Increment to invalidate all existing sessions for this user.
  sessionVersion Int      @default(0) @map("session_version")
  createdAt      DateTime @default(now()) @map("created_at")

  facility           Facility?  @relation(fields: [facilityId], references: [id])
  kakaoIdentity KakaoIdentity?
  sessions      ServerSession[]
  deliveryAttempts DeliveryAttempt[]
  @@map("users")
}

/// Kakao OAuth identity. Access token encrypted at rest (AES-256-GCM); refresh token not stored (this build).
model KakaoIdentity {
  id             String    @id @default(cuid())
  userId         String    @unique @map("user_id")
  facilityId          String?   @map("facility_id")
  kakaoId        String    @map("kakao_id")
  accessTokenCipher String? @map("access_token_cipher")
  tokenScope        String? @map("token_scope")
  tokenExpiresAt DateTime? @map("token_expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility  Facility? @relation(fields: [facilityId], references: [id])
  @@map("kakao_identities")
}

/// Server-side session root for JWT revocation and SSE re-auth. Session lookup is
/// by opaque session id/user id only; tenant-domain access starts after facility GUC binding.
model ServerSession {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  facilityId     String?   @map("facility_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility  Facility? @relation(fields: [facilityId], references: [id])
  @@map("server_sessions")
}

// ─── Tenant tables (facilityId-scoped, RLS ENABLE + FORCE) ────────────────────────

/// Facility resident. RLS-protected. Composite unique (facilityId, id) allows
/// child tables to reference residents via composite FKs (F9).
model Resident {
  id        String   @id @default(cuid())
  facilityId     String   @map("facility_id")
  name      String
  room      String?
  isActive Boolean @default(true) @map("is_active")
  gender    String?
  age       Int?
  diagnosisTags String[] @default([]) @map("diagnosis_tags")
  fallRiskBaseline Level? @map("fall_risk_baseline")
  isFocusResident Boolean @default(false) @map("is_focus_resident")
  createdAt DateTime @default(now()) @map("created_at")

  facility            Facility   @relation(fields: [facilityId], references: [id])
  guardians      Guardian[]
  cameras        Camera[]
  alerts         Alert[]
  residentStatus ResidentStatus?
  assignments ResidentAssignment[]

  @@unique([facilityId, id])
  @@map("residents")
}


model ResidentAssignment {
  id         String    @id @default(cuid())
  facilityId String    @map("facility_id")
  residentId String    @map("resident_id")
  spaceId    String    @map("space_id")
  zoneId     String?   @map("zone_id")
  startedAt  DateTime  @default(now()) @map("started_at")
  endedAt    DateTime? @map("ended_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  facility Facility @relation(fields: [facilityId], references: [id])
  resident Resident @relation(fields: [facilityId, residentId], references: [facilityId, id])
  space    Space    @relation(fields: [facilityId, spaceId], references: [facilityId, id])
  zone     Zone?    @relation(fields: [facilityId, zoneId], references: [facilityId, id])

  @@unique([facilityId, id])
  @@index([facilityId, residentId])
  @@map("resident_assignments")
}

/// Emergency contact. Composite FK (facilityId, residentId) → Resident(facilityId, id)
/// prevents a guardian from being linked to a resident in a different facility (F9).
model Guardian {
  id         String   @id @default(cuid())
  facilityId      String   @map("facility_id")
  residentId String   @map("resident_id")
  name       String
  /// Phone is stored in full; masked in UI layer.
  phone      String
  relation   String?
  createdAt  DateTime @default(now()) @map("created_at")

  facility      Facility @relation(fields: [facilityId], references: [id])
  resident Resident     @relation(fields: [facilityId, residentId], references: [facilityId, id])
  @@map("guardians")
}

/// Ingest-capable camera. Composite unique (facilityId, id) to support composite FK
/// references from Alert. ingestKeyId is a selector (no auth value alone).
model Camera {
  id               String    @id @default(cuid())
  facilityId            String    @map("facility_id")
  /// Required room anchor; resident_id remains only for legacy data until PR8.
  residentId       String?   @map("resident_id")
  spaceId          String    @map("space_id")
  label            String
  /// Selector-only key identifier sent in X-Ingest-KeyId header.
  ingestKeyId      String    @map("ingest_key_id")
  /// SHA-256 hash of the HMAC secret (never store plaintext).
  ingestSecretHash String    @map("ingest_secret_hash")
  lastSeenAt       DateTime? @map("last_seen_at")
  online           Boolean   @default(false)
  createdAt        DateTime  @default(now()) @map("created_at")

  facility      Facility @relation(fields: [facilityId], references: [id])
  /// Composite FK (facilityId, residentId) → Resident(facilityId, id) prevents
  /// a camera from being assigned to a resident in a different facility (F9).
  resident Resident?    @relation(fields: [facilityId, residentId], references: [facilityId, id])
  space    Space        @relation(fields: [facilityId, spaceId], references: [facilityId, id])
  alerts   Alert[]
  residentStatuses ResidentStatus[] @relation("ResidentStatusSource")

  @@unique([facilityId, id])
  @@unique([facilityId, label])
  @@unique([facilityId, ingestKeyId])
  @@unique([facilityId, spaceId])
  @@map("cameras")
}

/// Alert event log. alertSeq (BIGSERIAL) is the SSE Last-Event-ID ordering key.
/// Composite unique (facilityId, idempotencyKey) prevents exact-duplicate ingestion.
model Alert {
  id             String      @id @default(cuid())
  /// Monotonically increasing within the table; used as SSE Last-Event-ID.
  alertSeq       BigInt      @default(autoincrement()) @map("alert_seq")
  facilityId          String      @map("facility_id")
  residentId     String      @map("resident_id")
  /// Nullable: alert may originate from an unconfigured camera path.
  cameraId       String?     @map("camera_id")
  spaceId        String?     @map("space_id")
  type           String
  probability    Float
  /// Internal facility-scoped storage key for the snapshot image (never a raw URL).
  snapshotKey    String?     @map("snapshot_key")
  detectedAt     DateTime    @map("detected_at")
  status         AlertStatus @default(NEW)
  /// Server-derived: hash(cameraId + detectedAt + type). Sender-supplied keys ignored.
  idempotencyKey String      @map("idempotency_key")
  createdAt      DateTime    @default(now()) @map("created_at")

  facility      Facility @relation(fields: [facilityId], references: [id])
  resident Resident     @relation(fields: [facilityId, residentId], references: [facilityId, id])
  /// Composite FK (facilityId, cameraId) → Camera(facilityId, id) prevents
  /// an alert from referencing a camera in a different facility (F9).
  camera   Camera?      @relation(fields: [facilityId, cameraId], references: [facilityId, id])
  space    Space?       @relation(fields: [facilityId, spaceId], references: [facilityId, id])

  @@unique([facilityId, idempotencyKey])
  @@index([facilityId, alertSeq])
  @@index([facilityId, spaceId, alertSeq])
  @@map("alerts")
}

/// Current status read model for each resident. One row per resident.
/// Composite FK (facilityId, residentId) → Resident(facilityId, id) (F9).
model ResidentStatus {
  id           String        @id @default(cuid())
  residentId   String        @unique @map("resident_id")
  facilityId        String        @map("facility_id")
  state        ResidentState @default(NORMAL)
  lastSeenAt   DateTime?     @map("last_seen_at")
  cameraOnline Boolean       @default(false) @map("camera_online")
  /// Nullable cameraId. Composite FK (facilityId, sourceId) → Camera(facilityId, id)
  /// prevents dangling or cross-facility status source references.
  sourceId     String?       @map("source_id")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  facility      Facility @relation(fields: [facilityId], references: [id])
  resident Resident     @relation(fields: [facilityId, residentId], references: [facilityId, id])
  source   Camera?      @relation("ResidentStatusSource", fields: [facilityId, sourceId], references: [facilityId, id])

  @@unique([facilityId, residentId])
  @@map("resident_statuses")
}


/// Facility floor. RLS-protected. Composite unique (facilityId, id) supports
/// composite child FKs from spaces.
model Floor {
  id         String   @id @default(cuid())
  facilityId String   @map("facility_id")
  name       String
  orderIndex Int      @map("order_index")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  facility Facility @relation(fields: [facilityId], references: [id])
  spaces   Space[]

  @@unique([facilityId, name])
  @@unique([facilityId, id])
  @@map("floors")
}

/// Facility space/room. cameraId is nullable and intentionally has no FK until
/// the camera-to-space remodel lands.
model Space {
  id            String    @id @default(cuid())
  facilityId    String    @map("facility_id")
  floorId       String    @map("floor_id")
  name          String
  type          SpaceType
  capacity      Int
  cameraId      String?   @map("camera_id")
  isActive      Boolean   @default(true) @map("is_active")
  assignedStaff String?   @map("assigned_staff")
  createdAt     DateTime  @default(now()) @map("created_at")

  facility Facility @relation(fields: [facilityId], references: [id])
  floor    Floor    @relation(fields: [facilityId, floorId], references: [facilityId, id])
  zones    Zone[]
  assignments ResidentAssignment[]
  camera   Camera?
  alerts   Alert[]

  @@unique([facilityId, floorId, name])
  @@unique([facilityId, id])
  @@map("spaces")
}

/// Named area inside a space.
model Zone {
  id         String   @id @default(cuid())
  facilityId String   @map("facility_id")
  spaceId    String   @map("space_id")
  name       String
  type       ZoneType
  orderIndex Int      @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")

  facility Facility @relation(fields: [facilityId], references: [id])
  space    Space    @relation(fields: [facilityId, spaceId], references: [facilityId, id])
  assignments ResidentAssignment[]

  @@unique([facilityId, spaceId, name])
  @@unique([facilityId, id])
  @@map("zones")
}

// ─── Backend-owned alert outbox (issue #29) ─────────────────────────────────
// AlertEvent/DeliveryAttempt are NOT tenant-domain RLS tables. They are keyed
// by source_id (ingest source) + external_event_id for idempotency, owned by the
// backend alert pipeline, and intentionally excluded from PrismaService's
// TENANT_MODELS guard (no facility context required). See backend/ADR-035..038.

enum AlertEventType {
  FALL
  DETECTION_LOST
  BED_EXIT
}

enum AlertDecision {
  DISPATCH
  SUPPRESS
}

enum AlertSuppressedReason {
  COOLDOWN
  HOURLY_CAP
  BELOW_THRESHOLD
}

enum DeliveryChannel {
  KAKAO_SEND_TO_ME
}

enum DeliveryAttemptStatus {
  PENDING
  SENT
  RETRY_SCHEDULED
  TERMINAL_FAILED
}

enum DeliveryFailureClass {
  TRANSIENT
  TERMINAL_OPERATOR_ACTION
}

/// Backend alert outbox row. (source_id, external_event_id) is the idempotency
/// key; P2002 on that unique constraint signals a duplicate ingress.
model AlertEvent {
  id                 String                 @id @default(cuid())
  sourceId           String                 @map("source_id")
  externalEventId    String                 @map("external_event_id")
  type               AlertEventType
  detectedAt         DateTime               @map("detected_at")
  confidence         Float?
  fallProbability    Float?                 @map("fall_probability")
  operatingThreshold Float?                 @map("operating_threshold")
  decision           AlertDecision
  suppressedReason   AlertSuppressedReason? @map("suppressed_reason")
  deliveryAttempts   DeliveryAttempt[]
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  @@unique([sourceId, externalEventId], name: "alert_events_source_external_event_id_key")
  @@index([detectedAt], name: "alert_events_detected_at_idx")
  @@map("alert_events")
}

/// Per-channel delivery attempt with retry/terminal classification.
model DeliveryAttempt {
  id                String                @id @default(cuid())
  alertEventId      String                @map("alert_event_id")
  alertEvent        AlertEvent            @relation(fields: [alertEventId], references: [id], onDelete: Cascade)
  recipientUserId   String?               @map("recipient_user_id")
  recipientUser     User?                 @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)
  channel           DeliveryChannel
  status            DeliveryAttemptStatus @default(PENDING)
  attemptCount      Int                   @default(0) @map("attempt_count")
  nextAttemptAt     DateTime?             @map("next_attempt_at")
  providerReference String?               @map("provider_reference")
  failureClass      DeliveryFailureClass? @map("failure_class")
  terminalReason    String?               @map("terminal_reason")
  operatorAction    String?               @map("operator_action")
  lastError         String?               @map("last_error")
  sentAt            DateTime?             @map("sent_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt], name: "delivery_attempts_status_next_attempt_at_idx")
  @@index([alertEventId], name: "delivery_attempts_alert_event_id_idx")
  @@unique([alertEventId, recipientUserId], name: "delivery_attempts_alert_event_id_recipient_user_id_key")
  @@index([recipientUserId], name: "delivery_attempts_recipient_user_id_idx")
  @@map("delivery_attempts")
}
