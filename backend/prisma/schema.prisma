// Prisma schema — Postgres everywhere (dev/prod differ only by DATABASE_URL).
// NOTE: Prisma bakes `provider` into the schema AND migrations; engine is NOT
// runtime-swappable (unlike Hibernate dialects). Keep provider = postgresql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

