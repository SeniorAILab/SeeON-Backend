# Build context is the repo root for host service Dockerfiles. Keep lockfiles and
# source; drop VCS, installed dependencies, build outputs, and local env/state.
.git
**/node_modules
**/.next
**/dist
**/.venv
**/__pycache__
**/*.pyc
**/*.pt
**/*.pth
**/*.onnx
**/*.safetensors
.gjc
*.log
**/.env
**/.env.*
!**/.env.example
**/coverage
.DS_Store
