# Host production environment contract.
#
# Copy this file to .env.host.prod and fill real values:
#   cp .env.host.prod.example .env.host.prod
#
# .env.host.prod is gitignored.

NODE_ENV=production

# Exact browser origins accepted during the production overlap. Keep localhost in
# .env.local only. FRONT_ORIGIN remains a compatibility fallback only when this
# plural variable is absent.
FRONT_ORIGINS=https://seeon.seniorsailab.com,http://49.247.204.81
# FRONT_ORIGIN=
ALERT_DASHBOARD_URL=

# PostgreSQL roles. APP_DB_USER must stay fall_app because migrations grant
# privileges to that role. Use URL-encoded credentials in DATABASE_URL and
# DIRECT_URL when passwords contain reserved URL characters such as @, :, /, #.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
APP_DB_USER=fall_app
APP_DB_PASSWORD=
DATABASE_URL=
DIRECT_URL=

# Production images are built locally by Jenkins and tagged with the exact main SHA.
# The deploy script writes these values to the host-only release-images.env file.
BACKEND_IMAGE=eldercare-backend:<git-sha>
API_INGRESS_IMAGE=eldercare-api-ingress:<git-sha>
FRONT_IMAGE=eldercare-front:<git-sha>

# Jenkins safety receipts. These host paths and volume names are controller-level
# configuration, not secrets, and must identify an owner-only off-host backup
# destination and the production clips volume.
# EVENT_MEDIA_BACKUP_DESTINATION=/absolute/separate-mount/path
# EVENT_MEDIA_CLIP_VOLUME=compose_clips
# COMPOSE_PROJECT_NAME=eldercare-fall-ai

# Backend auth and outbound alert email (SMTP).
SESSION_JWT_SECRET=
# Required secret used to derive edge credential hashes. Generate a unique value;
# never commit or reuse a real pepper.
EDGE_TOKEN_PEPPER=
# Deprecated shared-token compatibility path for Edge boxes that have not yet
# enrolled per-installation eft_v1 credentials. Fail-closed by default — only
# the literal string 'true' activates it. Keep it 'true' only for the
# documented migration window of the current, not-yet-enrolled production
# Edge; set both this and EDGE_LEGACY_FACILITY_ID back to blank once that
# Edge has enrolled and is authenticating with eft_v1 credentials.
EDGE_LEGACY_COMPAT_ENABLED=true
# Required whenever EDGE_LEGACY_COMPAT_ENABLED=true. The legacy path never
# trusts a client-supplied facility scope (x-facility-id) — it is pinned
# here, server-side, to the single facility the not-yet-enrolled Edge
# belongs to for the pilot. Leave blank once legacy compat is turned off.
EDGE_LEGACY_FACILITY_ID=
# SMTP_HOST/SMTP_USER/SMTP_PASSWORD are required in production. SMTP_PASSWORD is
# a secret (e.g. a Gmail app password) — never commit a real value here.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
# Optional; defaults: SMTP_PORT=587, and omitted SMTP_SECURE lets the adapter use
# SMTP_SECURE=true when SMTP_PORT=465.
# SMTP_PORT=587
# SMTP_FROM=
# SMTP_SECURE=false
# Shared bearer token required for remote Event API producers.
EDGE_FACILITY_TOKEN=
# During overlap, auto uses req.secure only when the immediate peer is on the
# fixed private ingress network. Pin true after legacy HTTP retirement.
AUTH_COOKIE_SECURE=auto

# Event clips remain disabled until the storage/capacity/backup release gates pass.
# The frontend value is baked into its release image; Jenkins reads this exact
# host-only value without sourcing or printing the rest of the environment file.
EVENT_CLIPS_ENABLED=false
VITE_EVENT_CLIPS_ENABLED=false

# Backend-owned immutable clip storage. Production keeps at least 60 days until
# Korean counsel classifies derived event clips. The free-space floor must cover
# at least one maximum-sized upload; the release validator rejects weaker values.
MEDIA_RETENTION_DAYS=60
MEDIA_MIN_FREE_BYTES=1073741824
MEDIA_CLIP_MAX_BYTES=268435456

# Nokyang seed admin password. Fill real values only in secrets; no production
# default is provided by prisma:seed.
NOKYANG_ADMIN_PASSWORD=

# Managed production super-admin bootstrap. All four inputs are required. The
# one-release source email claims only the pre-existing product-admin row; the
# managed key remains immutable after `prisma migrate deploy`.
SUPER_ADMIN_MANAGED_KEY=senior-ai-lab-primary
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_BOOTSTRAP_SOURCE_EMAIL=
