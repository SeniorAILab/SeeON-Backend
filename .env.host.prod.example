# Host production environment contract.
#
# Copy this file to .env.host.prod and fill real values:
#   cp .env.host.prod.example .env.host.prod
#
# .env.host.prod is gitignored.

NODE_ENV=production

# Public browser origin for the deployed frontend. Must match Kakao Web platform
# domain and backend CORS/callback expectations.
FRONT_ORIGIN=
ALERT_DASHBOARD_URL=

# PostgreSQL roles. APP_DB_USER must stay fall_app because migrations grant
# privileges to that role. Use URL-encoded credentials in DATABASE_URL and
# DIRECT_URL when passwords contain reserved URL characters such as @, :, /, #.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
APP_DB_USER=fall_app
APP_DB_PASSWORD=
DATABASE_URL=
DIRECT_URL=

# Production Compose pulls prebuilt images. The Naver Cloud GitHub Actions
# deploy fills these with the exact commit SHA tag.
BACKEND_IMAGE=ghcr.io/goberomsu/eldercare-fall-ai/backend:<git-sha>
FRONT_IMAGE=ghcr.io/goberomsu/eldercare-fall-ai/front:<git-sha>

# Backend auth and Kakao integration.
SESSION_JWT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=
KAKAO_TOKEN_ENC_KEY=
# KAKAO_CLIENT_SECRET=
# KAKAO_SCOPES=talk_message
# KAKAO_MESSAGE_LINK_URL=
# KAKAO_MESSAGE_ENDPOINT=https://kapi.kakao.com/v2/api/talk/memo/default/send

# Optional future topology: backend-pull ML prediction. Current production
# topology keeps ML on the edge and pushes signed events to /ingest.
# ML_SERVING_URL=
