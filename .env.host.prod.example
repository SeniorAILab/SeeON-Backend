# Host production environment contract.
#
# Copy this file to .env.host.prod and fill real values:
#   cp .env.host.prod.example .env.host.prod
#
# .env.host.prod is gitignored.

NODE_ENV=production

# Public browser origin for the deployed frontend. Must match Kakao Web platform
# domain and backend CORS/callback expectations.
FRONT_ORIGIN=
ALERT_DASHBOARD_URL=

# PostgreSQL roles. APP_DB_USER must stay fall_app because migrations grant
# privileges to that role. Use URL-encoded credentials in DATABASE_URL and
# DIRECT_URL when passwords contain reserved URL characters such as @, :, /, #.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
APP_DB_USER=fall_app
APP_DB_PASSWORD=
DATABASE_URL=
DIRECT_URL=

# Production Compose pulls prebuilt host images. The release also publishes
# ml-api/ml-worker with the same exact commit SHA for the edge compose stack.
BACKEND_IMAGE=ghcr.io/seniorailab/eldercare-fall-ai/backend:<git-sha>
FRONT_IMAGE=ghcr.io/seniorailab/eldercare-fall-ai/front:<git-sha>
# Edge-only pins for .env.edge.prod, shown here to keep the 4-image release tag
# contract visible in the host production env contract.
ML_API_IMAGE=ghcr.io/seniorailab/eldercare-fall-ai/ml-api:<git-sha>
ML_WORKER_IMAGE=ghcr.io/seniorailab/eldercare-fall-ai/ml-worker:<git-sha>

# Backend auth and Kakao integration.
SESSION_JWT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=
KAKAO_TOKEN_ENC_KEY=
# Shared bearer token the edge ml-api attaches to Event API requests (issue #552).
# Must match .env.edge.prod's EDGE_FACILITY_TOKEN exactly. Deploy order: deploy the
# edge stack (ml-api sending the bearer) before deploying this enforcement here.
EDGE_FACILITY_TOKEN=
# Leave blank to derive from FRONT_ORIGIN. Set true for HTTPS, false for the
# temporary HTTP/IP deployment.
AUTH_COOKIE_SECURE=
# KAKAO_CLIENT_SECRET=
# KAKAO_SCOPES=talk_message
# KAKAO_MESSAGE_LINK_URL=
# KAKAO_MESSAGE_ENDPOINT=https://kapi.kakao.com/v2/api/talk/memo/default/send

# Nokyang seed admin password. Fill real values only in secrets; no production
# default is provided by prisma:seed.
NOKYANG_ADMIN_PASSWORD=

# Production super-admin bootstrap. When SUPER_ADMIN_PASSWORD is set, the
# safe deploy idempotently upserts this email/password account as SUPER_ADMIN after
# `prisma migrate deploy`. Leave SUPER_ADMIN_PASSWORD empty to skip the bootstrap.
# SUPER_ADMIN_EMAIL defaults to admin@example.com when unset.
# SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NICKNAME=
# SUPER_ADMIN_FACILITY_ID=

# Optional future topology: backend-pull ML prediction. Current production
# topology keeps ML on the edge and posts no-HMAC events to /api/v1/events.
# ML_SERVING_URL=
