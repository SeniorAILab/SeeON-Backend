# Host production environment contract.
#
# Copy this file to .env.host.prod and fill real values:
#   cp .env.host.prod.example .env.host.prod
#
# .env.host.prod is gitignored.

NODE_ENV=production

# Public browser origin for the deployed frontend. Must match backend CORS/callback
# expectations.
FRONT_ORIGIN=
ALERT_DASHBOARD_URL=

# PostgreSQL roles. APP_DB_USER must stay fall_app because migrations grant
# privileges to that role. Use URL-encoded credentials in DATABASE_URL and
# DIRECT_URL when passwords contain reserved URL characters such as @, :, /, #.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
APP_DB_USER=fall_app
APP_DB_PASSWORD=
DATABASE_URL=
DIRECT_URL=

# Production Compose pulls prebuilt host images.
BACKEND_IMAGE=ghcr.io/seniorailab/eldercare-fall-ai/backend:<git-sha>
FRONT_IMAGE=ghcr.io/seniorailab/eldercare-fall-ai/front:<git-sha>

# Backend auth and outbound alert email (SMTP).
SESSION_JWT_SECRET=
# SMTP_HOST/SMTP_USER/SMTP_PASSWORD are required in production. SMTP_PASSWORD is
# a secret (e.g. a Gmail app password) — never commit a real value here.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
# Optional; defaults: SMTP_PORT=587, SMTP_SECURE=true when SMTP_PORT=465.
# SMTP_PORT=587
# SMTP_FROM=
# SMTP_SECURE=false
# Shared bearer token required for remote Event API producers.
EDGE_FACILITY_TOKEN=
# Leave blank to derive from FRONT_ORIGIN. Set true for HTTPS, false for the
# temporary HTTP/IP deployment.
AUTH_COOKIE_SECURE=

# Nokyang seed admin password. Fill real values only in secrets; no production
# default is provided by prisma:seed.
NOKYANG_ADMIN_PASSWORD=

# Production super-admin bootstrap. When SUPER_ADMIN_PASSWORD is set, the
# safe deploy idempotently upserts this email/password account as SUPER_ADMIN after
# `prisma migrate deploy`. Leave SUPER_ADMIN_PASSWORD empty to skip the bootstrap.
# SUPER_ADMIN_EMAIL defaults to admin@example.com when unset.
# SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NICKNAME=
# SUPER_ADMIN_FACILITY_ID=
